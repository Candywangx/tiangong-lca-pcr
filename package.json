{
  "name": "@tiangong-lca/pcr-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "node builder/cli/index.mjs init",
    "lint": "npm run vocab:check && npm run aliases:check && npm run catalog:check && npm run cpc-chains:check && node builder/cli/index.mjs lint --report .reports/pcr-lint.json",
    "test": "node scripts/engineering/suites.ts run all",
    "validate": "npm run runtime:check && npm run migration:check && npm run typecheck:all && npm run lint && npm test",
    "vocab:generate": "node builder/scripts/generate-controlled-vocabulary.mjs",
    "vocab:check": "node builder/scripts/generate-controlled-vocabulary.mjs --check",
    "aliases:build": "node builder/scripts/build-pcr-id-aliases.mjs",
    "aliases:check": "node builder/scripts/build-pcr-id-aliases.mjs --check",
    "catalog:build": "node builder/scripts/build-catalog.mjs",
    "catalog:check": "node builder/scripts/build-catalog.mjs --check",
    "catalog:recover": "node builder/scripts/build-catalog.mjs --recover",
    "cpc-chains:build": "node builder/scripts/render-cpc-product-chain.mjs",
    "cpc-chains:check": "node builder/scripts/render-cpc-product-chain.mjs --check",
    "goal:doctor": "node builder/cli/goal.mjs doctor",
    "goal:plan": "node builder/cli/goal.mjs plan",
    "goal:start": "node builder/cli/goal.mjs start",
    "goal:status": "node builder/cli/goal.mjs status",
    "goal:resume": "node builder/cli/goal.mjs resume",
    "goal:integrate": "node builder/cli/goal.mjs integrate",
    "goal:land": "node builder/cli/goal.mjs land",
    "goal:viewer-publish": "node builder/cli/goal.mjs viewer-publish",
    "goal:viewer-recover": "node builder/cli/goal.mjs viewer-recover",
    "goal:stop": "node builder/cli/goal.mjs stop",
    "goal:uuid-search": "node builder/cli/goal-uuid-search.mjs",
    "goal:uuid-audit": "node builder/cli/goal.mjs uuid-audit",
    "pcr:materials": "node builder/cli/materials.mjs",
    "pcr:import:cpc": "node builder/cli/index.mjs import-cpc",
    "pcr:scaffold:cpc": "node builder/scripts/scaffold-leaf-pcrs.mjs",
    "pcr:sync-structured": "node builder/cli/index.mjs sync-structured",
    "pcr:lifecycle": "node builder/cli/index.mjs lifecycle",
    "pcr:bump": "node builder/cli/index.mjs bump",
    "pcr:revise": "node builder/cli/index.mjs revise",
    "pcr:publish": "node builder/cli/index.mjs publish",
    "pcr:recover": "node builder/cli/index.mjs recover",
    "tiangong-pcr": "node packages/tiangong-pcr-cli/bin/tiangong-pcr.mjs",
    "viewer:build": "node packages/pcr-viewer/scripts/build-viewer-data.mjs build",
    "viewer:update": "node packages/pcr-viewer/scripts/build-viewer-data.mjs update",
    "viewer:check": "node packages/pcr-viewer/scripts/build-viewer-data.mjs check",
    "viewer:recover": "node packages/pcr-viewer/scripts/build-viewer-data.mjs recover",
    "viewer:serve": "node packages/pcr-viewer/scripts/serve-viewer.mjs",
    "pcr:check": "node builder/cli/index.mjs check",
    "goal:prepare-report": "node builder/cli/goal-prepare-report.mjs",
    "docs:build": "npm --prefix packages/pcr-docs run build",
    "docs:dev": "npm --prefix packages/pcr-docs run dev",
    "docs:verify": "npm --prefix packages/pcr-docs run verify",
    "offline:library": "node builder/scripts/build-offline-library.mjs",
    "offline:tool": "node builder/scripts/build-offline-packages.mjs",
    "offline:test": "node --test packages/pcr-core/offline-library.test.mjs",
    "release:build": "node builder/scripts/npm-release.mjs build",
    "release:test": "node --test builder/scripts/npm-release.test.mjs",
    "product:build": "node builder/scripts/product-release.mjs build",
    "product:verify": "node builder/scripts/product-release.mjs verify",
    "product:publish": "node builder/scripts/product-publish.mjs",
    "product:test": "node --test builder/scripts/product-*.test.mjs",
    "runtime:check": "node scripts/engineering/runtime.ts",
    "runtime:release": "node scripts/engineering/runtime.ts --release",
    "migration:check": "node scripts/engineering/migration.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.semantic.json --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix packages/pcr-docs run typecheck",
    "build:engineering": "tsc -p tsconfig.build.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "test:list": "node scripts/engineering/suites.ts list --json",
    "test:unit": "node scripts/engineering/suites.ts run unit",
    "test:contracts": "node scripts/engineering/suites.ts run contracts",
    "test:integration": "node scripts/engineering/suites.ts run integration",
    "test:recovery": "node scripts/engineering/suites.ts run recovery",
    "test:docs": "node scripts/engineering/suites.ts run docs",
    "test:offline": "node scripts/engineering/suites.ts run offline",
    "test:product": "node scripts/engineering/suites.ts run product",
    "test:engineering": "node scripts/engineering/suites.ts run engineering",
    "test:coverage": "npm run build:tests && c8 --all --src scripts/engineering --include \"scripts/engineering/**/*.ts\" --exclude \"**/*.test.ts\" --exclude-after-remap --reporter=text --reporter=lcov --reporter=json-summary --reports-dir .reports/coverage/engineering node --test \"dist/test-engineering/scripts/engineering/*.test.js\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@12.2.0"
}
