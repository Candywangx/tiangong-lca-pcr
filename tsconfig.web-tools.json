{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/pcr-docs/scripts/*.ts",
    "packages/pcr-viewer/scripts/*.ts"
  ]
}
