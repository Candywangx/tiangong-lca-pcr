{
  "schemaVersion": 1,
  "roots": [
    "builder",
    "packages",
    "scripts",
    "_tests",
    "docs"
  ],
  "pendingPrefixes": [
    "packages/pcr-docs/app/",
    "packages/pcr-docs/components/",
    "packages/pcr-docs/lib/",
    "packages/pcr-viewer/static/"
  ],
  "exclusions": [
    {
      "path": "packages/pcr-core/src/generated/controlled-vocabulary.ts",
      "reason": "Reviewed generated vocabulary; generator remains included."
    },
    {
      "path": "builder/goal-harness/fixtures/assertions.ts",
      "reason": "Test-only assertion helper."
    },
    {
      "path": "builder/goal-harness/fixtures/original-source.ts",
      "reason": "Historical test-only source fixture."
    },
    {
      "path": "builder/goal-harness/fixtures/review-results.ts",
      "reason": "Test-only review result constructor."
    },
    {
      "path": "builder/goal-harness/viewer-test-api.ts",
      "reason": "Test-only Viewer transport adapter."
    },
    {
      "path": "builder/goal-harness/viewer-test-fixture.ts",
      "reason": "Test-only Viewer temporary fixture."
    },
    {
      "path": "builder/lib/measurement-fixture.ts",
      "reason": "Historical test-only measurement copy."
    },
    {
      "path": "builder/lib/pcr-authoring-fixture.ts",
      "reason": "Test-only PCR authoring fixture."
    },
    {
      "path": "packages/pcr-core/fixtures/read-session-fixture.ts",
      "reason": "Test-only actual SQLite fixture builder."
    },
    {
      "path": "docs/superpowers/records/2026-09-14-prepared-review-recovery-synthetic-replay.ts",
      "reason": "Retained historical test replay, not production runtime."
    },
    {
      "path": "builder/lib/fixtures/transaction-recovery.ts",
      "reason": "Test-only transaction recovery fixture constructor."
    }
  ],
  "thresholds": {
    "lines": 90,
    "functions": 90,
    "branches": 85
  },
  "critical": [
    {
      "prefix": "packages/pcr-core/src/compiler/",
      "branches": 95
    },
    {
      "prefix": "packages/pcr-core/src/projection-integrity.ts",
      "branches": 95
    },
    {
      "prefix": "builder/lib/catalog-artifact-transaction.ts",
      "branches": 95
    },
    {
      "prefix": "builder/lib/pcr-directory-transaction.ts",
      "branches": 95
    },
    {
      "prefix": "builder/goal-harness/receipt-integrity.ts",
      "branches": 95
    }
  ]
}
