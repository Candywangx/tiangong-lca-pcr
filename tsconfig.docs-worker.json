{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "lib": [
      "ES2024",
      "WebWorker",
      "WebWorker.Iterable"
    ],
    "rootDir": "packages/pcr-docs/lib",
    "outDir": "dist/browser/docs-worker"
  },
  "include": [
    "packages/pcr-docs/lib/search-worker.ts",
    "packages/pcr-docs/lib/search-terms.ts"
  ]
}
