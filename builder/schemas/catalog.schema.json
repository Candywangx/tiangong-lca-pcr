{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/catalog.schema.json",
  "title": "TianGong PCR catalog",
  "type": "object",
  "required": ["schema_version", "catalog_status", "pcr_index", "pcr_id_aliases", "classification_mappings", "notes"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_status": { "enum": ["scaffold", "current"] },
    "pcr_index": { "type": "string", "minLength": 1 },
    "pcr_id_aliases": {
      "type": "object",
      "required": ["path", "hash_mode", "sha256", "entry_count"],
      "properties": {
        "path": { "const": "classifications/aliases/pcr-id-aliases.yaml" },
        "hash_mode": { "const": "exact_bytes" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "entry_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "classification_mappings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "classification_coverage_indexes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "catalog_status": { "const": "current" } },
        "required": ["catalog_status"]
      },
      "then": {
        "required": ["classification_coverage_indexes"],
        "properties": { "classification_coverage_indexes": true }
      }
    }
  ],
  "additionalProperties": false
}
