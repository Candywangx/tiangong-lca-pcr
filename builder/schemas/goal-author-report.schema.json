{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/goal-author-report.schema.json",
  "title": "TianGong PCR Goal author report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cpc_code", "product_name_en", "product_name_zh", "pcr_path", "queue_action",
    "files", "sources", "uuid_audits", "rejected_uuid_candidates", "inventory", "reference_product_uuid_confirmed",
    "ranges", "bilingual", "structured_sync", "validate", "commit_sha", "unresolved_issues"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "cpc_code": { "type": "string", "pattern": "^[0-9]+$" },
    "product_name_en": { "type": "string", "minLength": 1 },
    "product_name_zh": { "type": "string", "minLength": 1 },
    "pcr_path": { "$ref": "#/$defs/repoPath" },
    "queue_action": { "enum": ["create_new", "promote_legacy"] },
    "files": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "uuid_audits": { "type": "array", "items": { "$ref": "#/$defs/uuidAudit" } },
    "rejected_uuid_candidates": { "type": "array", "items": { "$ref": "#/$defs/rejectedUuid" } },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_rows", "matched_rows", "unresolved_rows", "unresolved"],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "matched_rows": { "type": "integer", "minimum": 0 },
        "unresolved_rows": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } }
      }
    },
    "reference_product_uuid_confirmed": { "type": "boolean" },
    "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
    "bilingual": {
      "type": "object", "additionalProperties": false,
      "required": ["aligned", "en_inventory_rows", "zh_inventory_rows"],
      "properties": {
        "aligned": { "type": "boolean" },
        "en_inventory_rows": { "type": "integer", "minimum": 0 },
        "zh_inventory_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "structured_sync": {
      "type": "object", "additionalProperties": false,
      "required": ["first_run_ok", "second_run_clean", "schema_valid"],
      "properties": {
        "first_run_ok": { "type": "boolean" },
        "second_run_clean": { "type": "boolean" },
        "schema_valid": { "type": "boolean" }
      }
    },
    "validate": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "exit_code", "known_shared_artifact_only"],
      "properties": {
        "ok": { "type": "boolean" },
        "exit_code": { "type": "integer" },
        "known_shared_artifact_only": { "type": "boolean" },
        "summary": { "type": "string" }
      }
    },
    "complexity_justification": { "type": "string", "minLength": 20 },
    "cartesian_expansion_review": { "type": "string", "minLength": 20 },
    "methodology_necessity_approved": { "type": "boolean" },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "unresolved_issues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "repoPath": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "name", "locator", "original_text_verified", "supports"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "original_text_verified": { "type": "boolean" },
        "supports": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "discovery_only": { "type": "boolean" }
      }
    },
    "uuidAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["uuid", "hybrid_search", "state_code", "base_name_en", "base_name_zh", "flow_type", "classification", "property", "unit_group", "semantic_review"],
      "properties": {
        "uuid": { "type": "string", "format": "uuid" },
        "hybrid_search": { "type": "boolean" },
        "state_code": { "const": 100 },
        "base_name_en": { "type": "string", "minLength": 1 },
        "base_name_zh": { "type": "string", "minLength": 1 },
        "flow_type": { "type": "string", "minLength": 1 },
        "classification": { "type": "string" },
        "property": { "type": "string", "minLength": 1 },
        "unit_group": { "type": "string", "minLength": 1 },
        "semantic_review": { "type": "string", "minLength": 1 }
      }
    },
    "rejectedUuid": {
      "type": "object", "additionalProperties": false,
      "required": ["uuid", "reason"],
      "properties": { "uuid": { "type": "string", "format": "uuid" }, "reason": { "type": "string", "minLength": 1 } }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["row_id", "reason_code", "explanation"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "reason_code": { "enum": ["no_exact_candidate", "semantic_mismatch", "classification_mismatch", "product_state_mismatch", "flow_type_mismatch", "property_or_unit_mismatch", "state_not_public", "internal_intermediate_needs_new_flow", "tiangong_lookup_rate_limited", "tiangong_cli_unavailable", "manual_review_required"] },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["range_id", "evidence_kind", "source_ids", "original_text_verified", "independent_source_count", "provisional"],
      "properties": {
        "range_id": { "type": "string", "minLength": 1 },
        "evidence_kind": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "original_text_verified": { "type": "boolean" },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "provisional": { "type": "boolean" },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "synthesis": { "type": "string" }
      }
    }
  }
}
