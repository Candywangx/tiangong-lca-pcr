{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-revision.schema.json",
  "title": "TianGong PCR open revision metadata",
  "type": "object",
  "required": [
    "schema_version",
    "pcr_id",
    "base_version",
    "target_version",
    "opened_at_utc"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_id": { "$ref": "#/$defs/pcrId" },
    "base_version": { "$ref": "#/$defs/semver" },
    "target_version": { "$ref": "#/$defs/semver" },
    "opened_at_utc": { "$ref": "#/$defs/utcTimestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "pcrId": {
      "type": "string",
      "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}
