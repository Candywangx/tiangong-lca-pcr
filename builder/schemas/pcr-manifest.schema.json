{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-manifest.schema.json",
  "title": "TianGong PCR manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "pcr_kind",
    "content_maturity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "updated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "published_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "title": {
      "type": "object",
      "required": ["en-US", "zh-CN"],
      "properties": {
        "en-US": { "type": "string", "minLength": 1 },
        "zh-CN": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "status": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/pcr_status"
    },
    "pcr_kind": { "const": "product_category_rule" },
    "content_maturity": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/content_maturity"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "object",
      "required": ["core"],
      "properties": {
        "core": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/target_entity"
      }
    },
    "languages": {
      "type": "object",
      "required": ["canonical", "available"],
      "properties": {
        "canonical": { "const": "en-US" },
        "available": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "en-US" } },
            { "contains": { "const": "zh-CN" } }
          ],
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "translation_status": {
      "type": "object",
      "required": ["zh-CN"],
      "properties": {
        "zh-CN": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
        }
      },
      "additionalProperties": {
        "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
      }
    },
    "classification_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/classificationRef" }
    },
    "review_metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "classificationRef": {
      "type": "object",
      "required": ["system", "version", "code", "title", "mapping_type"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "mapping_type": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/classification_mapping_relation"
        }
      },
      "additionalProperties": false
    }
  }
}
