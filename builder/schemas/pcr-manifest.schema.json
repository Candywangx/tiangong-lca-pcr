{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-manifest.schema.json",
  "title": "TianGong PCR manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "pcr_kind",
    "content_maturity"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "updated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "published_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "title": {
      "type": "object",
      "$comment": "Any canonical BCP 47 language may carry a title; the builder additionally enforces Intl.getCanonicalLocales spelling. Only the two exact required codes are reserved, and the allOf entry below pins their shape: en-US must be a non-empty string.",
      "required": ["en-US", "zh-CN"],
      "properties": {
        "en-US": true,
        "zh-CN": true
      },
      "patternProperties": {
        "^(?!(?:en-US$|zh-CN$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "The two reserved codes are pinned in a nested schema so the language pattern stays open to en-* and zh-* siblings such as en-GB and zh-TW.",
          "properties": {
            "en-US": { "type": "string", "minLength": 1 },
            "zh-CN": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "status": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/pcr_status"
    },
    "pcr_kind": { "const": "product_category_rule" },
    "content_maturity": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/content_maturity"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "object",
      "required": ["core"],
      "properties": {
        "core": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/target_entity"
      }
    },
    "languages": {
      "type": "object",
      "required": ["canonical", "available"],
      "properties": {
        "canonical": { "const": "en-US" },
        "available": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "en-US" } },
            { "contains": { "const": "zh-CN" } }
          ],
          "items": {
            "$comment": "en-US and zh-CN are always required; any other canonical BCP 47 language is optional and requires schema_version 2. The builder's declaredPcrLanguages enforces Intl.getCanonicalLocales spelling beyond this shape.",
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        }
      },
      "additionalProperties": false
    },
    "translation_status": {
      "type": "object",
      "$comment": "One controlled translation status per declared language; the allOf entry below pins en-US to the canonical marker.",
      "required": ["zh-CN"],
      "properties": {
        "en-US": true,
        "zh-CN": true
      },
      "patternProperties": {
        "^(?!(?:en-US$|zh-CN$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "zh-CN": {
              "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
            }
          }
        }
      ]
    },
    "classification_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/classificationRef" }
    },
    "review_metadata": { "type": "object" },
    "release_artifacts": {
      "type": "object",
      "properties": {
        "pcr_en_us_sha256": { "$ref": "#/$defs/sha256" },
        "pcr_zh_cn_sha256": { "$ref": "#/$defs/sha256" },
        "structured_sha256": { "$ref": "#/$defs/sha256" },
        "markdown_sha256": {
          "type": "object",
          "$comment": "One Markdown hash per declared language. Schema version 2 additionally requires the en-US and zh-CN keys.",
          "minProperties": 2,
          "properties": {
            "en-US": true,
            "zh-CN": true
          },
          "patternProperties": {
            "^(?!(?:en-US$|zh-CN$))[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "en-US": { "$ref": "#/$defs/sha256" },
                "zh-CN": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Pins the shape of the two required languages: a non-empty English title, a Chinese title, and the canonical English status marker. They are pinned in a nested schema so the language pattern stays open to every other canonical BCP 47 code, including en-* and zh-* siblings.",
      "properties": {
        "title": {
          "type": "object",
          "required": ["en-US"],
          "properties": {
            "en-US": { "type": "string", "minLength": 1 }
          }
        },
        "translation_status": {
          "type": "object",
          "properties": {
            "en-US": { "const": "canonical" }
          }
        }
      }
    },
    {
      "$comment": "A managed published or deprecated manifest owns release_artifacts; an unpublished workspace does not.",
      "if": {
        "properties": {
          "status": { "enum": ["published", "deprecated"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": { "release_artifacts": true },
        "required": ["release_artifacts"]
      },
      "else": {
        "properties": { "release_artifacts": false }
      }
    },
    {
      "$comment": "Schema v1 is the legacy two-language contract: no optional language may be declared or fingerprinted. The builder refuses to publish an optional language file while the manifest is v1.",
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "languages": {
            "type": "object",
            "properties": {
              "available": {
                "type": "array",
                "maxItems": 2,
                "items": { "enum": ["en-US", "zh-CN"] }
              }
            }
          },
          "translation_status": {
            "type": "object",
            "properties": {
              "en-US": { "const": "canonical" },
              "zh-CN": true
            }
          },
          "release_artifacts": {
            "type": "object",
            "required": [
              "pcr_en_us_sha256",
              "pcr_zh_cn_sha256",
              "structured_sha256"
            ],
            "properties": {
              "pcr_en_us_sha256": true,
              "pcr_zh_cn_sha256": true,
              "structured_sha256": true,
              "markdown_sha256": false
            }
          }
        }
      }
    },
    {
      "$comment": "Schema v2 fingerprints every declared Markdown language by language key and binds the structured projection. The builder additionally requires the hash key set to equal languages.available exactly.",
      "if": {
        "properties": {
          "schema_version": { "const": 2 },
          "release_artifacts": { "type": "object" }
        },
        "required": ["schema_version", "release_artifacts"]
      },
      "then": {
        "properties": {
          "release_artifacts": {
            "type": "object",
            "required": ["markdown_sha256", "structured_sha256"],
            "properties": {
              "markdown_sha256": {
                "type": "object",
                "required": ["en-US", "zh-CN"],
                "properties": {
                  "en-US": true,
                  "zh-CN": true
                }
              },
              "structured_sha256": true,
              "pcr_en_us_sha256": false,
              "pcr_zh_cn_sha256": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "classificationRef": {
      "type": "object",
      "required": ["system", "version", "code", "title", "mapping_type"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "mapping_type": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/classification_mapping_relation"
        }
      },
      "additionalProperties": false
    }
  }
}
