{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-markdown-frontmatter.schema.json",
  "title": "TianGong PCR Markdown frontmatter",
  "type": "object",
  "required": ["pcr_id", "language", "status", "sync_with"],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_id": {
      "type": "string",
      "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "language": { "enum": ["en-US", "zh-CN"] },
    "status": { "enum": ["scaffold", "candidate", "active", "published", "deprecated"] },
    "content_maturity": {
      "enum": [
        "empty_scaffold",
        "draft_methodology",
        "authored_methodology",
        "reviewed_methodology",
        "published_methodology",
        "deprecated_methodology"
      ]
    },
    "translation_status": {
      "enum": [
        "canonical",
        "not_available",
        "scaffold",
        "scaffold_pending_translation",
        "draft_translation",
        "aligned",
        "reviewed",
        "out_of_sync"
      ]
    },
    "sync_with": { "enum": ["pcr.en-US.md", "pcr.zh-CN.md"] }
  },
  "additionalProperties": false
}
