{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-markdown-frontmatter.schema.json",
  "title": "TianGong PCR Markdown frontmatter",
  "type": "object",
  "required": ["pcr_id", "language", "status", "sync_with"],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_id": {
      "type": "string",
      "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "language": { "enum": ["en-US", "zh-CN"] },
    "status": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/pcr_status"
    },
    "content_maturity": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/content_maturity"
    },
    "translation_status": {
      "anyOf": [
        { "const": "canonical" },
        {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
        }
      ]
    },
    "sync_with": { "enum": ["pcr.en-US.md", "pcr.zh-CN.md"] }
  },
  "additionalProperties": false
}
