{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-markdown-frontmatter.schema.json",
  "title": "TianGong PCR Markdown frontmatter",
  "type": "object",
  "required": ["pcr_id", "language", "status", "sync_with"],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_id": {
      "type": "string",
      "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "language": { "$ref": "#/$defs/languageCode" },
    "status": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/pcr_status"
    },
    "content_maturity": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/content_maturity"
    },
    "translation_status": {
      "anyOf": [
        { "const": "canonical" },
        {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/translation_status"
        }
      ]
    },
    "sync_with": { "$ref": "#/$defs/markdownFileName" }
  },
  "additionalProperties": false,
  "$defs": {
    "languageCode": {
      "$comment": "Canonical BCP 47 PCR language spelling; the builder additionally enforces Intl.getCanonicalLocales equality and manifest declaration.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "markdownFileName": {
      "$comment": "A sibling PCR Markdown file. The builder additionally requires the target to be a declared language file in the same workspace and derives the language file set from manifest.languages.available; undeclared or traversal-shaped names are rejected.",
      "type": "string",
      "pattern": "^pcr\\.[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*\\.md$"
    }
  }
}
