{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/goal-harness-config.schema.json",
  "title": "TianGong PCR Goal harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "project_root",
    "target_category_path",
    "classification_system",
    "classification_version",
    "cpc_selector",
    "policy_prompt_path"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "goal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "project_root": { "type": "string", "minLength": 1 },
    "target_category_path": { "type": "string", "minLength": 1 },
    "classification_system": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "classification_version": { "type": "string", "minLength": 1 },
    "cpc_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value"],
      "properties": {
        "mode": { "const": "target_category" },
        "value": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+$" } }
          ]
        }
      }
    },
    "skip_cpc_list": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+$" } },
    "author_slots": { "type": "integer", "minimum": 1, "maximum": 6 },
    "integration_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 },
    "policy_prompt_path": { "type": "string", "minLength": 1 },
    "author_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_repairs": { "type": "integer", "minimum": 0, "maximum": 10 },
        "backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": { "type": "string", "minLength": 1 },
        "tiangong_cli_root": { "type": "string", "minLength": 1 },
        "flow_hybrid_search_root": { "type": "string", "minLength": 1 },
        "paper_search": { "type": "string", "minLength": 1 },
        "credentials_env_file": { "type": "string", "minLength": 1 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracked_roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } },
        "untracked_allowlist": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
        "approval_policy": { "enum": ["untrusted", "on-request", "never"] },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decided_by": { "type": "string", "minLength": 1 },
        "final_partial_batch": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    }
  }
}
