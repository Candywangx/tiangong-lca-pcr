{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/pcr-release.schema.json",
  "title": "TianGong PCR immutable release metadata",
  "type": "object",
  "required": [
    "schema_version",
    "pcr_id",
    "version",
    "published_at_utc",
    "predecessor_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_id": { "$ref": "#/$defs/pcrId" },
    "version": { "$ref": "#/$defs/semver" },
    "published_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "predecessor_version": {
      "oneOf": [
        { "$ref": "#/$defs/semver" },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "manifest_snapshot_sha256",
        "pcr_en_us_sha256",
        "pcr_zh_cn_sha256",
        "structured_sha256"
      ],
      "properties": {
        "manifest_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "pcr_en_us_sha256": { "$ref": "#/$defs/sha256" },
        "pcr_zh_cn_sha256": { "$ref": "#/$defs/sha256" },
        "structured_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pcrId": {
      "type": "string",
      "pattern": "^pcr\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
