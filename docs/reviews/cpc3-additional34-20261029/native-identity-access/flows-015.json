          "common:UUID": "26e896e8-a342-49cb-add3-400d237b5205",
          "common:name": [],
          "common:synonyms": [
            {
              "#text": "聚氨酯合成革；PU革；聚氨酯革；双层皮革",
              "@xml:lang": "zh"
            },
            {
              "#text": "polyurethane synthetic leather; PU leather; polyurethane leather; bicast leather",
              "@xml:lang": "en"
            }
          ],
          "common:shortName": [],
          "common:generalComment": [
            {
              "#text": "Polyurethane Synthetic Leather, also known as PU leather, is a synthetic material made by coating a fabric backing with a flexible polymer. It is completely artificial and considered vegan. It offers a soft and luxurious feel, resembling genuine leather. PU leather is highly durable, resistant to wear and tear, and easier to clean. It is commonly used in upholstery, furniture, and clothing.",
              "@xml:lang": "en"
            },
            {
              "#text": "聚氨酯合成皮革，也被称为PU皮革，是一种通过在织物背衬上涂覆柔韧聚合物制成的合成材料。它完全是人造的，被认为是纯素的。它提供了柔软和豪华的感觉，类似于真皮。PU皮革具有高耐久性，抗磨损，且更易清洁。它常用于室内装饰，家具和服装。",
              "@xml:lang": "zh"
            }
          ],
          "classificationInformation": {
            "common:classification": {
              "common:class": [
                {
                  "#text": "Food products, beverages and tobacco; textiles, apparel and leather products",
                  "@level": "0",
                  "@classId": "2"
                },
                {
                  "#text": "Leather and leather products; footwear",
                  "@level": "1",
                  "@classId": "29"
                },
                {
                  "#text": "Tanned or dressed leather; composition leather",
                  "@level": "2",
                  "@classId": "291"
                },
                {
                  "#text": "Other leather, without hair on (including sheep, lamb, goat or kid skin leather); composition leather with a basis of leather or leather fibre",
                  "@level": "3",
                  "@classId": "2913"
                },
                {
                  "#text": "Other leather, without hair on (including sheep, lamb, goat or kid skin leather); composition leather with a basis of leather or leather fibre",
                  "@level": "4",
                  "@classId": "29130"
                }
              ]
            }
          }
        },
