{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist/runtime",
    "declaration": false,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "pcr://source/",
    "resolveJsonModule": true
  },
  "include": [
    "packages/pcr-core/src/**/*",
    "packages/tiangong-pcr-cli/src/**/*",
    "packages/tiangong-pcr-cli/bin/**/*"
  ],
  "exclude": ["**/*.test.*", "**/node_modules/**"]
}
