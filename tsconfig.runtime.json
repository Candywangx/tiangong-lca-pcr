{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist/runtime",
    "declaration": false,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "pcr://source/",
    "resolveJsonModule": true
  },
  "include": [
    "packages/pcr-core/src/**/*.ts",
    "packages/tiangong-pcr-cli/src/**/*.ts",
    "packages/tiangong-pcr-cli/bin/**/*.ts"
  ],
  "exclude": [
    "**/*.test.*",
    "**/node_modules/**"
  ]
}
