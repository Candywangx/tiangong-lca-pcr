{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "packages/pcr-viewer/static",
    "outDir": "dist/browser/viewer"
  },
  "include": [
    "packages/pcr-viewer/static/*.ts"
  ]
}
