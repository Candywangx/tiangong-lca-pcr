{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/guidance-batch-request.schema.json",
  "title": "PCR guidance batch request",
  "type": "object",
  "required": ["schema_version", "pcr_ids"],
  "properties": {
    "schema_version": { "const": 1 },
    "pcr_ids": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
  },
  "additionalProperties": false
}
