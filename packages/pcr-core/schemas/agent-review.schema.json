{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/agent-review.schema.json",
  "title": "PCR Agent review evidence envelope; never a methodology approval",
  "type": "object",
  "required": ["schema_version", "report_kind", "status", "pcr", "inputs", "scope", "coverage", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "report_kind": { "const": "tiangong-pcr-agent-review" },
    "status": { "enum": ["draft", "reviewed"] },
    "pcr": { "$ref": "#/$defs/pcrBinding" },
    "inputs": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["file", "sha256", "kind", "uuid", "version"],
      "properties": {
        "file": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/hash" },
        "kind": { "$ref": "#/$defs/text" }, "uuid": { "type": ["string", "null"] }, "version": { "type": ["string", "null"] }
      }, "additionalProperties": false
    } },
    "scope": {
      "type": "object", "required": ["description", "applicability", "limitations"],
      "properties": {
        "description": { "$ref": "#/$defs/text" }, "applicability": { "$ref": "#/$defs/text" },
        "limitations": { "$ref": "#/$defs/texts" }
      }, "additionalProperties": true
    },
    "coverage": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["topic", "status", "rationale"],
      "properties": {
        "topic": { "$ref": "#/$defs/text" }, "status": { "enum": ["reviewed", "not_applicable", "not_reviewed"] },
        "rationale": { "$ref": "#/$defs/text" }
      }, "additionalProperties": true
    } },
    "findings": { "type": "array", "items": {
      "type": "object", "required": ["id", "kind", "severity", "observation", "rationale", "input_refs", "pcr_refs", "suggested_action", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["confirmed_issue", "suspected_anomaly", "evidence_gap"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "observation": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" },
        "input_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inputRef" } },
        "pcr_refs": { "type": "array", "items": { "allOf": [
          { "$ref": "#/$defs/pcrBinding" },
          { "type": "object", "required": ["pointer"], "properties": { "pointer": { "type": "string" } } }
        ] } },
        "suggested_action": { "$ref": "#/$defs/text" }, "questions": { "$ref": "#/$defs/texts" },
        "alternative_explanations": { "$ref": "#/$defs/texts" }
      }, "additionalProperties": true
    } }
  },
  "additionalProperties": true,
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputRef": {
      "type": "object", "required": ["file", "sha256", "pointer"],
      "properties": { "file": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/hash" }, "pointer": { "type": "string" } },
      "additionalProperties": false
    },
    "pcrBinding": {
      "type": "object", "required": ["pcr_id", "version", "projection_sha256", "markdown_sha256", "methodology_status"],
      "properties": {
        "pcr_id": { "$ref": "#/$defs/text" }, "version": { "type": ["string", "null"] },
        "projection_sha256": { "$ref": "#/$defs/hash" }, "markdown_sha256": { "$ref": "#/$defs/hash" },
        "methodology_status": { "$ref": "#/$defs/text" }
      }, "additionalProperties": true
    }
  }
}
