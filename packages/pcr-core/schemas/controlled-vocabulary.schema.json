{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json",
  "title": "TianGong PCR controlled vocabulary",
  "$defs": {
    "amount_range_role": {
      "type": "string",
      "enum": [
        "qa_guardrail",
        "typical_range",
        "allowed_range",
        "default_estimate",
        "uncertainty_range"
      ]
    },
    "amount_specificity": {
      "type": "string",
      "enum": [
        "generic",
        "site_specific",
        "product_specific",
        "route_specific",
        "scenario_specific",
        "technology_specific",
        "not_applicable"
      ]
    },
    "amount_value_mode": {
      "type": "string",
      "enum": [
        "fixed_value",
        "foreground_record",
        "calculated_value",
        "modelled_estimate",
        "not_applicable"
      ]
    },
    "basis_kind": {
      "type": "string",
      "enum": [
        "reference_flow",
        "process_output",
        "n_input",
        "fuel_inventory",
        "transport_service",
        "storage_duration",
        "crop_cycle"
      ]
    },
    "classification_coverage_status": {
      "type": "string",
      "enum": [
        "mapped",
        "unmapped",
        "candidate_suggestion",
        "manual_review",
        "unknown"
      ]
    },
    "classification_mapping_relation": {
      "type": "string",
      "enum": [
        "exact",
        "broader",
        "narrower",
        "proxy",
        "manual_review"
      ]
    },
    "content_maturity": {
      "type": "string",
      "enum": [
        "empty_scaffold",
        "draft_methodology",
        "authored_methodology",
        "reviewed_methodology",
        "published_methodology",
        "deprecated_methodology"
      ]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "external_source",
        "observed_dataset",
        "method_formula",
        "foreground_data",
        "tiangong_default",
        "collected_record",
        "calculated_from_collection",
        "identity_reference",
        "source_rule",
        "reasoned_estimate"
      ]
    },
    "feedback_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "missing_pcr",
        "classification_mapping_gap",
        "unclear_reference_flow",
        "wrong_or_missing_uuid",
        "process_boundary_issue",
        "inventory_flow_gap",
        "range_evidence_update",
        "unit_or_flow_property_issue",
        "validation_rule_issue",
        "translation_mismatch",
        "source_update"
      ]
    },
    "flow_direction": {
      "type": "string",
      "enum": [
        "inputs",
        "outputs"
      ]
    },
    "flow_type": {
      "type": "string",
      "enum": [
        "product",
        "waste",
        "elementary"
      ]
    },
    "pcr_status": {
      "type": "string",
      "enum": [
        "scaffold",
        "candidate",
        "active",
        "published",
        "deprecated"
      ]
    },
    "process_inclusion": {
      "type": "string",
      "enum": [
        "required",
        "conditional",
        "optional",
        "excluded_by_default"
      ]
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official_guidance",
        "literature",
        "standard",
        "dataset",
        "method_factor",
        "extension_guidance",
        "handbook"
      ]
    },
    "target_entity": {
      "type": "string",
      "enum": [
        "flow",
        "process",
        "lifecyclemodel",
        "dataset"
      ]
    },
    "translation_status": {
      "type": "string",
      "enum": [
        "not_available",
        "scaffold",
        "scaffold_pending_translation",
        "draft_translation",
        "aligned",
        "reviewed",
        "out_of_sync"
      ]
    }
  }
}
