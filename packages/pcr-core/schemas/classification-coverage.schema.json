{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/classification-coverage.schema.json",
  "title": "TianGong PCR classification coverage index",
  "type": "object",
  "required": [
    "schema_version",
    "index_kind",
    "classification_system",
    "classification_version",
    "source",
    "summary",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "index_kind": { "const": "classification-pcr-coverage" },
    "classification_system": { "type": "string", "minLength": 1 },
    "classification_version": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "summary": { "$ref": "#/$defs/summary" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "coverageEntry": {
      "type": "object",
      "required": [
        "code",
        "label",
        "path_codes",
        "path_titles",
        "coverage_status",
        "mapping",
        "legacy_reference"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "path_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "path_titles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverage_status": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/classification_coverage_status"
        },
        "mapping": {
          "anyOf": [
            { "$ref": "#/$defs/mapping" },
            { "type": "null" }
          ]
        },
        "legacy_reference": {
          "anyOf": [
            { "$ref": "#/$defs/legacyReference" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "coverage_status": { "const": "mapped" } },
            "required": ["coverage_status"]
          },
          "then": {
            "properties": {
              "mapping": { "$ref": "#/$defs/mapping" },
              "legacy_reference": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage_status": { "enum": ["unmapped", "candidate_suggestion", "manual_review"] }
            },
            "required": ["coverage_status"]
          },
          "then": {
            "properties": { "mapping": { "type": "null" } }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "contract_version",
        "generator",
        "generator_version",
        "normalized_leaves",
        "mapping"
      ],
      "properties": {
        "contract_version": { "const": "2" },
        "generator": { "const": "builder/scripts/build-catalog.mjs" },
        "generator_version": { "const": "2" },
        "normalized_leaves": { "$ref": "#/$defs/sourceArtifact" },
        "mapping": { "$ref": "#/$defs/sourceArtifact" }
      },
      "additionalProperties": false
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["path", "hash_mode", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash_mode": { "const": "exact_bytes" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "type": "object",
      "required": ["total", "mapped", "unmapped", "candidate_suggestion", "manual_review", "unknown"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 },
        "candidate_suggestion": { "type": "integer", "minimum": 0 },
        "manual_review": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["pcr_id", "mapping_type", "confidence", "acceptance"],
      "properties": {
        "pcr_id": { "type": "string", "minLength": 1 },
        "mapping_type": {
          "allOf": [
            {
              "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/classification_mapping_relation"
            },
            { "not": { "const": "manual_review" } }
          ]
        },
        "confidence": { "type": "string", "minLength": 1 },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["status", "decided_by", "decided_at_utc", "decision_ref"],
      "properties": {
        "status": { "const": "accepted" },
        "decided_by": { "type": "string", "pattern": "\\S" },
        "decided_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "decision_ref": {
          "type": "string",
          "pattern": "^(?:docs|classifications/migrations)/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:md|ya?ml|json)(?:#[A-Za-z0-9][A-Za-z0-9._-]*)?$"
        }
      },
      "additionalProperties": false
    },
    "legacyReference": {
      "type": "object",
      "required": ["kind", "pcr_id", "path"],
      "properties": {
        "kind": { "const": "legacy_scaffold_reference" },
        "pcr_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
