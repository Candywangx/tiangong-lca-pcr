{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/feedback-intake.schema.json",
  "title": "TianGong PCR feedback intake",
  "type": "object",
  "required": ["feedback_type", "summary"],
  "properties": {
    "feedback_type": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/feedback_type"
    },
    "pcr_id": { "type": "string", "minLength": 1 },
    "pcr_version": { "type": "string" },
    "affected_section": { "type": "string" },
    "process_id": { "type": "string" },
    "flow_role": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "current_rule": { "type": "string" },
    "proposed_change": { "type": "string" },
    "evidence_sources": { "type": "string" },
    "model_impact": { "type": "string" },
    "confidence": {
      "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/feedback_confidence"
    },
    "generated_by": { "type": "string" }
  },
  "additionalProperties": false
}
