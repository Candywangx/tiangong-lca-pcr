{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-active",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "manifest_ref", "sequence"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "viewer-active" },
    "manifest_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 }
  }
}
