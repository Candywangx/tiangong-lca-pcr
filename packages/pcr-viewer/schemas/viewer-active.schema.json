{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-active",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "snapshot_id", "snapshot_url", "snapshot_hash", "manifest_ref", "sequence", "cache_version", "ui_bundle_ref", "validation_state"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "viewer-active" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "snapshot_url": { "type": "string", "minLength": 1 },
    "snapshot_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "manifest_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "cache_version": { "const": 1 },
    "ui_bundle_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validation_state": { "const": "validated" }
  }
}
