{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "viewer-history" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sequence", "manifest_ref"],
        "properties": { "sequence": { "type": "integer", "minimum": 1 }, "manifest_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
      }
    }
  }
}
