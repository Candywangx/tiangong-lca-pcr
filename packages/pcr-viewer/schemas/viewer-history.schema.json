{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "page_ref", "latest_sequence"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "viewer-history-head" },
    "page_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "latest_sequence": { "type": "integer", "minimum": 1 }
  }
}
